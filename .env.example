# Microsoft Teams / registro do bot
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# API REST do GLPI (URL terminando em /apirest.php)
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Consulta e resposta: tenant permitido e banco local persistente de vínculos
# Tenant vazio bloqueia consulta/resposta sem bloquear a abertura legada.
IDENTITY_ALLOWED_TENANT_ID=
# Opt-in: e-mail do membro Teams autenticado igual ao GLPI, administrado exclusivamente pela TI.
# False mantém criação manual; desativar não apaga vínculos existentes.
IDENTITY_AUTO_LINK_ENABLED=false
IDENTITY_DB_PATH=data/identity.sqlite3

# Notificações: ativação explícita e IDs GLPI administrativos separados por vírgula
# Grupos de autores e usuários de integração são listas não vazias, de tipos distintos.
# Localize os IDs reais dos grupos T.I e FlexSmart no GLPI; não use os nomes.
# NOTIFICATIONS_SUPPORT_IDS (usuários) foi substituída; não copie seus IDs para grupos.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_SUPPORT_GROUP_IDS=
NOTIFICATIONS_INTEGRATION_IDS=
NOTIFICATIONS_INTERVAL=10
